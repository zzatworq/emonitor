{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emonitor",
  "compatibility_date": "2026-09-07",
  "main": ".output/server/index.mjs",
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "env": {
    "production": {
      "routes": [
        {
          "pattern": "emonitor.zzatworq.dev",
          "zone_name": "zzatworq.dev"
        }
      ]
    }
  }
}
