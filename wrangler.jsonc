{
  "name": "emonitor",
  "compatibility_date": "2026-09-07",
  "main": ".vercel/output/functions/__server.func/index.mjs",
  "assets": {
    "directory": ".vercel/output/static",
    "binding": "ASSETS"
  },
  "env": {
    "production": {
      "routes": [
        {
          "pattern": "emonitor.zzatworq.dev",
          "zone_name": "zzatworq.dev"
        }
      ]
    }
  }
}
